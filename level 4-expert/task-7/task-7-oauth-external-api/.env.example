# ==============================================================================
# CityPulse Dashboard - Environment Configuration (.env.example)
# Copy this file to .env and adjust the values as needed.
# ==============================================================================

# Application port (default: 3000)
PORT=3000

# Node environment: 'development', 'production', or 'test'
NODE_ENV=development

# Session secret used to sign and encrypt session cookies.
# MUST BE at least 32 characters long for cryptographic security.
SESSION_SECRET=a_very_strong_and_secure_random_session_secret_key_1234567890

# GitHub OAuth 2.0 Client ID obtained from GitHub Developer Settings
# https://github.com/settings/developers
GITHUB_CLIENT_ID=your_github_oauth_client_id_here

# GitHub OAuth 2.0 Client Secret
GITHUB_CLIENT_SECRET=your_github_oauth_client_secret_here

# GitHub OAuth Callback URL (must match the Authorization callback URL in your GitHub OAuth App)
GITHUB_CALLBACK_URL=http://localhost:3000/auth/github/callback

# Allowed client origin for CORS and frontend redirects
CLIENT_ORIGIN=http://localhost:3000

# Demo mode toggle (true/false)
# When true, exposes /auth/demo-login for testing without GitHub credentials.
# AUTOMATICALLY DISABLED in production (NODE_ENV=production) for security.
DEMO_MODE=true
