# OpsDesk Server Configuration

# Application Port
PORT=4000

# Environment: development | production | test
NODE_ENV=development

# Logging level: debug | info | warn | error
LOG_LEVEL=info

# Allowed CORS Origin
CORS_ORIGIN=*

# Redis Connection URL
# Uncomment and configure if Redis is available (e.g. docker compose up -d or local Redis)
# If left blank, commented, or unreachable, OpsDesk automatically falls back to MEMORY mode.
# REDIS_URL=redis://127.0.0.1:6379
