  <!-- =========================================================================
       SECTION 4: PORTFOLIO / PROJECTS
       Features: Filterable gallery (All/Web/Mobile/AI), CSS Grid,
       CSS-gradient placeholder cards, and interactive hover overlay.
       ========================================================================= -->
  <section id="portfolio" class="section-padding section-portfolio">
    <div class="container">
      <div class="section-header text-center mx-auto mb-4 scroll-reveal" data-reveal="fade-up">
        <div class="section-tag mb-2">FEATURED WORK</div>
        <h2 class="section-title mb-3">Engineered for Real-World Impact</h2>
        <p class="section-subtitle text-secondary-theme">
          Browse our case studies showcasing how we solved mission-critical problems for global organizations.
        </p>
      </div>

