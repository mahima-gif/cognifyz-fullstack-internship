<%- include('partials/head', { pageTitle: pageTitle }) %>
<%- include('partials/navbar') %>

<main id="main-content">
  <!-- Server Alert Notification Banner (for Contact Form submission) -->
  <% if (alert) { %>
    <div class="container pt-5 mt-4">
      <div class="alert alert-<%= alert.type === 'danger' ? 'danger' : 'success' %> alert-dismissible fade show shadow-sm border-0 d-flex align-items-center gap-3" role="alert">
        <i class="bi <%= alert.type === 'danger' ? 'bi-exclamation-triangle-fill text-danger fs-4' : 'bi-check-circle-fill text-success fs-4' %>" aria-hidden="true"></i>
        <div class="flex-grow-1">
          <strong><%= alert.type === 'danger' ? 'Notice:' : 'Success!' %></strong> <%= alert.message %>
        </div>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
      </div>
    </div>
  <% } %>

  <!-- =========================================================================
       SECTION 1: HERO
       Features: Animated gradient background, gradient text with clamp(),
       pulsing CTA, and floating hero SVG graphic.
       ========================================================================= -->
  <section id="home" class="hero-section position-relative overflow-hidden d-flex align-items-center">
    <div class="hero-background-shapes" aria-hidden="true">
      <div class="shape shape-1"></div>
      <div class="shape shape-2"></div>
      <div class="shape shape-3"></div>
    </div>

    <div class="container position-relative z-1 py-5">
      <div class="row align-items-center g-5">
        <!-- Hero Content (Left) -->
        <div class="col-lg-6 text-center text-lg-start">
          <div class="badge-pill mb-3 scroll-reveal" data-reveal="fade-down">
            <span class="badge-dot"></span>
            <span>Next-Gen Cloud, AI & Web Architecture</span>
          </div>

          <h1 class="hero-title fw-bold mb-3 scroll-reveal" data-reveal="fade-up">
            Architecting <span class="gradient-text">Resilient Digital</span> Platforms for Tomorrow.
          </h1>

          <p class="hero-subtitle mb-4 scroll-reveal" data-reveal="fade-up" data-delay="100">
            NovaTech Solutions bridges cutting-edge cloud engineering, reactive web interfaces, and production-grade machine learning pipelines to accelerate business growth.
          </p>

          <div class="hero-cta-group d-flex flex-wrap justify-content-center justify-content-lg-start gap-3 mb-4 scroll-reveal" data-reveal="fade-up" data-delay="200">
            <a href="#services" class="btn btn-primary-gradient btn-lg btn-pulse d-inline-flex align-items-center gap-2">
              <span>Explore Services</span>
              <i class="bi bi-arrow-right" aria-hidden="true"></i>
            </a>
            <a href="#contact" class="btn btn-outline-theme btn-lg d-inline-flex align-items-center gap-2">
              <i class="bi bi-calendar-event" aria-hidden="true"></i>
              <span>Book Strategy Call</span>
            </a>
          </div>

          <!-- Trust Proof -->
          <div class="hero-trust d-flex align-items-center justify-content-center justify-content-lg-start gap-3 pt-2 scroll-reveal" data-reveal="fade-up" data-delay="300">
            <div class="avatar-stack d-flex" aria-hidden="true">
              <span class="avatar-circle">JD</span>
              <span class="avatar-circle">SK</span>
              <span class="avatar-circle">AM</span>
              <span class="avatar-circle">TL</span>
            </div>
            <div class="trust-text small">
              <div class="stars text-warning" aria-hidden="true">
                <i class="bi bi-star-fill"></i>
                <i class="bi bi-star-fill"></i>
                <i class="bi bi-star-fill"></i>
                <i class="bi bi-star-fill"></i>
                <i class="bi bi-star-fill"></i>
              </div>
              <span class="fw-semibold">Trusted by 250+ enterprise leaders worldwide</span>
            </div>
          </div>
        </div>

        <!-- Hero Illustration (Right) -->
        <div class="col-lg-6 scroll-reveal" data-reveal="zoom-in" data-delay="150">
          <div class="hero-graphic-container mx-auto">
            <!-- Glassmorphism Floating Badge 1 -->
            <div class="floating-stat-badge badge-top-left" aria-hidden="true">
              <i class="bi bi-shield-check text-success fs-4"></i>
              <div>
                <strong class="d-block">99.99%</strong>
                <small>Cloud SLA</small>
              </div>
            </div>

            <!-- Glassmorphism Floating Badge 2 -->
            <div class="floating-stat-badge badge-bottom-right" aria-hidden="true">
              <i class="bi bi-lightning-charge-fill text-warning fs-4"></i>
              <div>
                <strong class="d-block">&lt; 50ms</strong>
                <small>Global Latency</small>
              </div>
            </div>

            <!-- Central Hero Isometric SVG Artwork -->
            <div class="hero-artwork-frame">
              <svg class="hero-svg-illustration" viewBox="0 0 600 500" fill="none" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="NovaTech Cloud Architecture Illustration">
                <defs>
                  <linearGradient id="cubeGrad1" x1="0%" y1="0%" x2="100%" y2="100%">
                    <stop offset="0%" stop-color="#6366f1" />
                    <stop offset="100%" stop-color="#4338ca" />
                  </linearGradient>
                  <linearGradient id="cubeGrad2" x1="0%" y1="0%" x2="100%" y2="100%">
                    <stop offset="0%" stop-color="#06b6d4" />
                    <stop offset="100%" stop-color="#0e7490" />
                  </linearGradient>
                  <linearGradient id="cubeGrad3" x1="0%" y1="0%" x2="100%" y2="100%">
                    <stop offset="0%" stop-color="#ec4899" />
                    <stop offset="100%" stop-color="#be185d" />
                  </linearGradient>
                  <filter id="glowFilter" x="-20%" y="-20%" width="140%" height="140%">
                    <feGaussianBlur stdDeviation="8" result="blur" />
                    <feComposite in="SourceGraphic" in2="blur" operator="over" />
                  </filter>
                </defs>

                <!-- Grid Floor Mesh -->
                <g class="mesh-grid" opacity="0.3" stroke="currentColor" stroke-width="1">
                  <line x1="50" y1="350" x2="300" y2="470" />
                  <line x1="120" y1="320" x2="370" y2="440" />
                  <line x1="190" y1="290" x2="440" y2="410" />
                  <line x1="550" y1="350" x2="300" y2="470" />
                  <line x1="480" y1="320" x2="230" y2="440" />
                  <line x1="410" y1="290" x2="160" y2="410" />
                </g>

                <!-- Central Isometric Server Node / Platform -->
                <polygon points="300,180 480,270 300,360 120,270" fill="url(#cubeGrad1)" opacity="0.9" />
                <polygon points="120,270 300,360 300,430 120,340" fill="#312e81" />
                <polygon points="480,270 300,360 300,430 480,340" fill="#1e1b4b" />

                <!-- Upper Layer Floating Cloud Stack -->
                <polygon points="300,120 440,190 300,260 160,190" fill="url(#cubeGrad2)" opacity="0.85" />
                <polygon points="160,190 300,260 300,300 160,230" fill="#155e75" />
                <polygon points="440,190 300,260 300,300 440,230" fill="#083344" />

                <!-- Pulsing Core Orb -->
                <circle class="pulsing-core" cx="300" cy="190" r="28" fill="#38bdf8" filter="url(#glowFilter)" opacity="0.9" />
                <circle cx="300" cy="190" r="16" fill="#ffffff" />

                <!-- Floating Code Node (Left) -->
                <g class="floating-node-left">
                  <rect x="70" y="110" width="120" height="80" rx="12" fill="#1e293b" stroke="#38bdf8" stroke-width="2" />
                  <circle cx="90" cy="125" r="4" fill="#ef4444" />
                  <circle cx="102" cy="125" r="4" fill="#eab308" />
                  <circle cx="114" cy="125" r="4" fill="#22c55e" />
                  <line x1="85" y1="145" x2="160" y2="145" stroke="#94a3b8" stroke-width="3" stroke-linecap="round" />
                  <line x1="85" y1="160" x2="140" y2="160" stroke="#6366f1" stroke-width="3" stroke-linecap="round" />
                  <line x1="85" y1="175" x2="175" y2="175" stroke="#06b6d4" stroke-width="3" stroke-linecap="round" />
                </g>

                <!-- Floating AI Neural Node (Right) -->
                <g class="floating-node-right">
                  <rect x="410" y="80" width="130" height="90" rx="12" fill="#1e293b" stroke="#ec4899" stroke-width="2" />
                  <circle cx="440" cy="125" r="8" fill="#ec4899" />
                  <circle cx="500" cy="105" r="6" fill="#8b5cf6" />
                  <circle cx="495" cy="145" r="7" fill="#06b6d4" />
                  <line x1="440" y1="125" x2="500" y2="105" stroke="#cbd5e1" stroke-width="2" stroke-dasharray="3 3" />
                  <line x1="440" y1="125" x2="495" y2="145" stroke="#cbd5e1" stroke-width="2" stroke-dasharray="3 3" />
                </g>

                <!-- Connection Circuit Lines -->
                <path d="M190 150 Q 240 170 280 185" stroke="#38bdf8" stroke-width="2" stroke-dasharray="4 4" />
                <path d="M410 130 Q 360 160 320 185" stroke="#ec4899" stroke-width="2" stroke-dasharray="4 4" />
              </svg>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- =========================================================================
       SECTION 2: ABOUT
       Features: Two-column layout, story and key metrics with animated counters.
       ========================================================================= -->
  <section id="about" class="section-padding section-about">
    <div class="container">
      <div class="row align-items-center g-5">
        <!-- Story / Text (Left) -->
        <div class="col-lg-6 scroll-reveal" data-reveal="fade-right">
          <div class="section-tag mb-2">WHO WE ARE</div>
          <h2 class="section-title mb-3">
            Engineering Precision for the Modern Cloud Era
          </h2>
          <p class="text-secondary-theme lead mb-3">
            Founded by a collective of cloud architects and software craftsmen, NovaTech Solutions empowers businesses to outpace competition through robust digital engineering.
          </p>
          <p class="text-secondary-theme mb-4">
            We don't merely write code; we design fault-tolerant distributed systems, optimize latency, and implement end-to-end security frameworks tailored to high-scale traffic.
          </p>

          <!-- Core Values Checklist -->
          <div class="about-checklist d-flex flex-column gap-2 mb-4">
            <div class="d-flex align-items-start gap-2">
              <i class="bi bi-check2-circle text-primary fs-5 mt-1" aria-hidden="true"></i>
              <span><strong>Cloud-Native Infrastructure:</strong> Kubernetes, Terraform & serverless architectures.</span>
            </div>
            <div class="d-flex align-items-start gap-2">
              <i class="bi bi-check2-circle text-primary fs-5 mt-1" aria-hidden="true"></i>
              <span><strong>Enterprise AI Integration:</strong> Retrieval-Augmented Generation (RAG) and predictive analytics.</span>
            </div>
            <div class="d-flex align-items-start gap-2">
              <i class="bi bi-check2-circle text-primary fs-5 mt-1" aria-hidden="true"></i>
              <span><strong>Zero-Downtime Releases:</strong> Automated CI/CD pipelines with canary and blue-green deployments.</span>
            </div>
          </div>

          <a href="#services" class="btn btn-outline-theme d-inline-flex align-items-center gap-2">
            <span>Learn More About Our Capabilities</span>
            <i class="bi bi-arrow-right" aria-hidden="true"></i>
          </a>
        </div>

        <!-- Animated Counter Stats Grid (Right) -->
        <div class="col-lg-6 scroll-reveal" data-reveal="fade-left" data-delay="150">
          <div class="stats-grid">
            <!-- Stat 1 -->
            <div class="stat-card">
              <div class="stat-icon-wrapper mb-3" aria-hidden="true">
                <i class="bi bi-rocket-takeoff-fill"></i>
              </div>
              <div class="stat-number-wrapper">
                <span class="counter-number" data-target="250">0</span><span class="stat-suffix">+</span>
              </div>
              <h3 class="stat-label">Projects Delivered</h3>
              <p class="stat-desc">From Seed-stage MVPs to Tier-1 Enterprise Platforms.</p>
            </div>

            <!-- Stat 2 -->
            <div class="stat-card">
              <div class="stat-icon-wrapper mb-3" aria-hidden="true">
                <i class="bi bi-heart-pulse-fill"></i>
              </div>
              <div class="stat-number-wrapper">
                <span class="counter-number" data-target="99">0</span><span class="stat-suffix">%</span>
              </div>
              <h3 class="stat-label">Client Retention</h3>
              <p class="stat-desc">Long-term engineering partnerships built on trust.</p>
            </div>

            <!-- Stat 3 -->
            <div class="stat-card">
              <div class="stat-icon-wrapper mb-3" aria-hidden="true">
                <i class="bi bi-building-check"></i>
              </div>
              <div class="stat-number-wrapper">
                <span class="counter-number" data-target="85">0</span><span class="stat-suffix">+</span>
              </div>
              <h3 class="stat-label">Enterprise Partners</h3>
              <p class="stat-desc">Spanning FinTech, Healthcare, E-Commerce, and SaaS.</p>
            </div>

            <!-- Stat 4 -->
            <div class="stat-card">
              <div class="stat-icon-wrapper mb-3" aria-hidden="true">
                <i class="bi bi-shield-shaded"></i>
              </div>
              <div class="stat-number-wrapper">
                <span class="counter-number" data-target="24">0</span><span class="stat-suffix">/7</span>
              </div>
              <h3 class="stat-label">Active Monitoring</h3>
              <p class="stat-desc">Autonomous telemetry, alerting, and rapid incident response.</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- =========================================================================
       SECTION 3: SERVICES
       Features: Responsive grid of 6 cards with icons, lift & shadow transitions.
