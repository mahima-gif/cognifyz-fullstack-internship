<%- include('partials/head', { pageTitle: '404 - Page Not Found | NovaTech Solutions' }) %>
<%- include('partials/navbar') %>

<main id="main-content" class="error-page-wrapper d-flex align-items-center py-5">
  <div class="container text-center py-5 my-5">
    <div class="row justify-content-center">
      <div class="col-lg-7 col-md-9">
        <div class="error-visual mb-4">
          <div class="error-badge-glitch mx-auto">404</div>
          <svg class="error-svg-illustration my-3" width="120" height="120" viewBox="0 0 100 100" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <circle cx="50" cy="50" r="45" stroke="var(--primary-color, #4f46e5)" stroke-width="4" stroke-dasharray="6 6" />
            <path d="M30 40 L40 50 M40 40 L30 50" stroke="var(--danger-color, #ef4444)" stroke-width="4" stroke-linecap="round" />
            <path d="M70 40 L60 50 M60 40 L70 50" stroke="var(--danger-color, #ef4444)" stroke-width="4" stroke-linecap="round" />
            <path d="M35 70 Q50 60 65 70" stroke="var(--text-muted, #64748b)" stroke-width="4" stroke-linecap="round" fill="none" />
          </svg>
        </div>
        <h1 class="display-5 fw-bold mb-3">Endpoint Not Found</h1>
        <p class="lead text-muted mb-4">
          The requested route <code><%= typeof path !== 'undefined' ? path : '/unknown' %></code> could not be located on the NovaTech cloud cluster. It might have moved or been decommissioned.
        </p>
        <div class="d-flex flex-wrap justify-content-center gap-3">
          <a href="/" class="btn btn-primary-gradient px-4 py-2 d-inline-flex align-items-center gap-2">
            <i class="bi bi-house-door-fill" aria-hidden="true"></i>
            <span>Return to Homepage</span>
          </a>
          <a href="/#contact" class="btn btn-outline-theme px-4 py-2 d-inline-flex align-items-center gap-2">
            <i class="bi bi-headset" aria-hidden="true"></i>
            <span>Contact Support</span>
          </a>
        </div>
      </div>
    </div>
  </div>
</main>

<%- include('partials/footer') %>

