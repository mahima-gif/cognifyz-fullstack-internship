<%- include('partials/header') %>

<div style="max-width: 580px; margin: 40px auto; text-align: center;">

  <div style="background-color: #ffffff; border: 1px solid #fee2e2; border-radius: 16px; padding: 48px 32px; box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);">
    
    <!-- Error Icon -->
    <div style="width: 64px; height: 64px; border-radius: 50%; background-color: #fef2f2; color: #dc2626; display: inline-flex; align-items: center; justify-content: center; font-size: 32px; margin-bottom: 20px;">
      ⚠️
    </div>

    <h1 style="margin: 0 0 12px 0; font-size: 28px; font-weight: 800; color: #991b1b;">
      Server Error (500)
    </h1>
    
    <p style="margin: 0 0 24px 0; font-size: 15px; color: #64748b; line-height: 1.6;">
      <%= message || 'An unexpected internal error occurred on the server.' %>
    </p>

    <a href="/" 
       style="display: inline-block; background-color: #2563eb; color: #ffffff; text-decoration: none; font-size: 14px; font-weight: 600; padding: 10px 22px; border-radius: 6px; transition: background-color 0.15s;"
       onmouseover="this.style.backgroundColor='#1d4ed8';"
       onmouseout="this.style.backgroundColor='#2563eb';">
      &larr; Back to Safe Harbor (Home)
    </a>

  </div>

</div>

<%- include('partials/footer') %>
