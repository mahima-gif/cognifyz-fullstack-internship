<%- include('partials/header') %>

<section class="card">
  <h1>Developer Community Portal</h1>
  <p class="lead">Connect with developers, share your tech stack, and explore shared interests.</p>

  <p>
    Welcome to our community platform! Whether you are building web apps, exploring artificial intelligence,
    designing user interfaces, or working in cloud engineering, this portal lets you register your profile
    and connect with fellow developers.
  </p>

  <div class="feature-grid">
    <div class="feature-box">
      <div class="feature-icon">&#128187;</div>
      <h3>Developer Profile</h3>
      <p>Share your contact details, country, and tech domains like Web Dev, Cloud, and AI/ML.</p>
    </div>

    <div class="feature-box">
      <div class="feature-icon">&#9889;</div>
      <h3>Instant Processing</h3>
      <p>Your data is processed and dynamically formatted on the server with live timestamps.</p>
    </div>

    <div class="feature-box">
      <div class="feature-icon">&#128274;</div>
      <h3>Data Validation</h3>
      <p>Built-in server verification ensures required contact information is accurate and complete.</p>
    </div>
  </div>

  <h2>Ready to get started?</h2>
  <p>Fill out the quick registration form to submit your details and view your confirmation summary.</p>
  
  <div class="button-group">
    <a href="/contact" class="btn btn-primary">Open Registration Form &rarr;</a>
  </div>
</section>

<%- include('partials/footer') %>
