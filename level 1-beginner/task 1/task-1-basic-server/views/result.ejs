<%- include('partials/header') %>

<section class="card">
  <div class="alert alert-success" role="status">
    <span>&#10004; <strong>Success:</strong> Form submission processed successfully!</span>
  </div>

  <h1>Submission Result</h1>
  <p class="lead">Here is the information captured and dynamically rendered by the server.</p>

  <p class="timestamp">
    <strong>Submitted on:</strong> <%= submittedAt %>
  </p>

  <table class="data-table" aria-label="Submitted User Details">
    <tbody>
      <tr>
        <th scope="row">Full Name</th>
        <td><%= user.name %></td>
      </tr>
      <tr>
        <th scope="row">Email Address</th>
        <td><%= user.email %></td>
      </tr>
      <tr>
        <th scope="row">Age</th>
        <td><%= user.age %></td>
      </tr>
      <tr>
        <th scope="row">Gender</th>
        <td><%= user.gender %></td>
      </tr>
      <tr>
        <th scope="row">Country</th>
        <td><%= user.country %></td>
      </tr>
      <tr>
        <th scope="row">Areas of Interest</th>
        <td>
          <% 
            // Safe handling: interests could be an array, string, or empty/undefined
            let list = [];
            if (Array.isArray(user.interests)) {
              list = user.interests;
            } else if (typeof user.interests === 'string' && user.interests.trim().length > 0) {
              list = [user.interests];
            }
          %>

          <% if (list.length > 0) { %>
            <ul class="badge-list">
              <% list.forEach(function(interest) { %>
                <li class="badge"><%= interest %></li>
              <% }); %>
            </ul>
          <% } else { %>
            <span style="color: var(--text-muted); font-style: italic;">No interests selected</span>
          <% } %>
        </td>
      </tr>
      <tr>
        <th scope="row">Message</th>
        <td style="white-space: pre-wrap;"><%= user.message %></td>
      </tr>
    </tbody>
  </table>

  <div class="button-group">
    <a href="/contact" class="btn btn-primary">&larr; Go Back to Form</a>
    <a href="/" class="btn btn-secondary">Return Home</a>
  </div>
</section>

<%- include('partials/footer') %>

