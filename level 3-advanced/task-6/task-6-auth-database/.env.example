# Server Configuration
PORT=3000
NODE_ENV=development

# Database Connection
# Replace YOUR_DB_PASSWORD with the Atlas database user password. If it contains special characters like @ # : / , URL-encode them.
MONGO_URI=mongodb+srv://YOUR_DB_USERNAME:YOUR_DB_PASSWORD@YOUR_CLUSTER_HOST/securetasks_db?retryWrites=true&w=majority

# JWT Authentication
# IMPORTANT: JWT_SECRET MUST be at least 32 characters long for cryptographic security
JWT_SECRET=your_jwt_secret_key_minimum_32_characters_long

JWT_EXPIRES_IN=1d

# Cookie Security
# Set to 'true' in production (requires HTTPS), 'false' for local development
COOKIE_SECURE=false

# Default Admin Account Seed Credentials (for `npm run seed`)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=your_admin_secure_password_123

# CORS Allowed Origin
CLIENT_ORIGIN=http://localhost:3000
